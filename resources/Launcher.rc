#pragma code_page(65001)
#include <windows.h>
#include "../src/ui/resource.h"

IDD_AI_LAUNCHER DIALOGEX 0, 0, 300, 262
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "件名:", -1, 17, 12, 38, 12
    LTEXT           "", IDC_MAIL_SUBJECT, 56, 12, 225, 18, SS_LEFT
    LTEXT           "差出人:", -1, 17, 32, 38, 12
    LTEXT           "", IDC_MAIL_FROM, 56, 32, 225, 18, SS_LEFT

    LTEXT           "本文プレビュー", -1, 17, 55, 264, 12
    EDITTEXT        IDC_MAIL_BODY, 17, 70, 264, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_MAIL_BODY_STATUS, 17, 148, 264, 14

    LTEXT           "Geminiモデル", -1, 17, 169, 122, 12
    LTEXT           "返信トーン：標準", IDC_REPLY_TONE_LABEL, 147, 169, 134, 12
    COMBOBOX        IDC_GEMINI_MODEL, 17, 184, 122, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_REPLY_TONE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 147, 182, 134, 25
    LTEXT           "強ビジネス文書", -1, 147, 208, 67, 12
    LTEXT           "簡潔", -1, 255, 208, 26, 12, SS_RIGHT

    PUSHBUTTON      "メール要約", IDC_AI_SUMMARY, 17, 227, 84, 26
    PUSHBUTTON      "返信文案", IDC_AI_REPLY, 107, 227, 84, 26
    PUSHBUTTON      "AIに相談", IDC_AI_CONSULT, 197, 227, 84, 26

END

IDD_AI_SETTINGS DIALOGEX 0, 0, 360, 400
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant - 設定"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "Gemini APIキー", -1, 12, 10, 240, 12
    EDITTEXT        IDC_GEMINI_API_KEY, 12, 27, 260, 18, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    PUSHBUTTON      "表示", IDC_SETTINGS_TOGGLE_KEY, 280, 27, 68, 18
    CONTROL         "", IDC_GEMINI_APIKEY_LINK, "SysLink", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 12, 51, 336, 16
    LTEXT           "キーはWindows DPAPIで暗号化して保存します。", -1, 12, 72, 336, 12
    LTEXT           "マスキング対象（種類ごとに選択）", -1, 12, 94, 336, 12
    CONTROL         "メールアドレス", IDC_MASK_EMAIL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 110, 150, 16
    CONTROL         "電話番号", IDC_MASK_PHONE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 130, 150, 16
    CONTROL         "郵便番号", IDC_MASK_POSTAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 150, 150, 16
    CONTROL         "IPアドレス", IDC_MASK_IP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 170, 150, 16
    CONTROL         "会社名", IDC_MASK_COMPANY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 110, 150, 16
    CONTROL         "氏名", IDC_MASK_PERSON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 130, 150, 16
    CONTROL         "住所", IDC_MASK_ADDRESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 150, 150, 16
    CONTROL         "口座・顧客・社員番号", IDC_MASK_ACCOUNT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 170, 168, 16
    CONTROL         "追加登録した語句", IDC_MASK_CUSTOM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 190, 180, 16
    LTEXT           "追加でマスキングする語句（1行に1件）", -1, 12, 212, 336, 12
    EDITTEXT        IDC_SETTINGS_MASK_TERMS, 12, 228, 336, 68, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "氏名・会社名などは自動検出できない場合があります。", -1, 12, 300, 336, 12
    CONTROL         "有料モデルも含める（課金対象の可能性あり）", IDC_SETTINGS_INCLUDE_PAID, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 322, 336, 16
    PUSHBUTTON      "APIモデルを更新", IDC_SETTINGS_UPDATE_MODELS, 12, 344, 104, 22
    LTEXT           "", IDC_SETTINGS_STATUS, 124, 348, 224, 18
    PUSHBUTTON      "接続テスト", IDC_SETTINGS_TEST, 12, 374, 85, 20
    DEFPUSHBUTTON   "保存", IDC_SETTINGS_SAVE, 218, 374, 60, 20
    PUSHBUTTON      "閉じる", IDCANCEL, 288, 374, 60, 20
END

IDD_AI_RESULT DIALOGEX 0, 0, 568, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Geminiによるメール要約"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "結果（返信文案は編集できます）", -1, 12, 10, 544, 14
    CONTROL         "", IDC_AI_RESULT_TEXT, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | ES_NOHIDESEL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 12, 29, 544, 240
    LTEXT           "", IDC_AI_COPY_STATUS, 12, 276, 255, 16
    PUSHBUTTON      "全文コピー", IDC_AI_COPY_ALL, 273, 273, 65, 24
    PUSHBUTTON      "返信に挿入", IDC_AI_INSERT_REPLY, 343, 273, 72, 24
    PUSHBUTTON      "全員に返信", IDC_AI_INSERT_REPLY_ALL, 420, 273, 82, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_RESULT_CLOSE, 507, 273, 49, 24
END


IDD_AI_CONSULT DIALOGEX 0, 0, 520, 360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "メールについてAIに相談"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "元メールと会話履歴を踏まえて追加質問できます。", -1, 12, 10, 496, 16
    LTEXT           "質問（複数行・箇条書き可）", -1, 12, 31, 200, 12
    EDITTEXT        IDC_AI_CONSULT_QUESTION, 12, 47, 496, 72, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "質問する", IDC_AI_CONSULT_SEND, 12, 126, 76, 24
    LTEXT           "", IDC_AI_CONSULT_STATUS, 98, 131, 410, 16
    LTEXT           "会話履歴（この画面を閉じると消去）", -1, 12, 160, 250, 12
    CONTROL         "", IDC_AI_CONSULT_RESPONSE, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 12, 176, 496, 134
    PUSHBUTTON      "回答をコピー", IDC_AI_CONSULT_COPY, 12, 322, 90, 24
    PUSHBUTTON      "履歴クリア", IDC_AI_CONSULT_CLEAR, 110, 322, 76, 24
    PUSHBUTTON      "回答から返信文案", IDC_AI_CONSULT_REPLY, 198, 322, 145, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_CONSULT_CLOSE, 445, 322, 63, 24
END

IDD_NEWMAIL_COMPOSE DIALOGEX 0, 0, 560, 460
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "AIで新規メール作成"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "メールの目的（必須）", -1, 12, 10, 260, 12
    EDITTEXT        IDC_NEWMAIL_PURPOSE, 12, 26, 536, 42, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "補足条件・含めたい内容（任意）", -1, 12, 74, 300, 12
    EDITTEXT        IDC_NEWMAIL_REQUIREMENTS, 12, 90, 536, 46, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "Geminiモデル", -1, 12, 146, 190, 12
    COMBOBOX        IDC_NEWMAIL_MODEL, 12, 162, 210, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "文体：標準", -1, 238, 146, 90, 12
    CONTROL         "", IDC_NEWMAIL_TONE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 338, 142, 210, 26
    LTEXT           "堅め", -1, 338, 170, 45, 12
    LTEXT           "簡潔", -1, 503, 170, 45, 12, SS_RIGHT
    PUSHBUTTON      "文案を作成", IDC_NEWMAIL_GENERATE, 12, 192, 92, 25
    LTEXT           "", IDC_NEWMAIL_STATUS, 116, 197, 432, 16
    LTEXT           "件名（編集可）", -1, 12, 226, 180, 12
    EDITTEXT        IDC_NEWMAIL_SUBJECT, 12, 242, 536, 24, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "本文（編集可）", -1, 12, 274, 180, 12
    EDITTEXT        IDC_NEWMAIL_BODY, 12, 290, 536, 112, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON   "作成画面に反映", IDC_NEWMAIL_APPLY, 346, 418, 110, 24
    PUSHBUTTON      "閉じる", IDCANCEL, 466, 418, 82, 24
END

IDD_PII_MASK_PREVIEW DIALOGEX 0, 0, 560, 410
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Gemini送信内容の確認"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "以下はマスキング後にGemini APIへ送信するユーザー情報です。内容を確認してください。", IDC_PII_MASK_PREVIEW_NOTE, 12, 10, 536, 24
    EDITTEXT        IDC_PII_MASK_PREVIEW_TEXT, 12, 40, 536, 320, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON   "この内容で送信", IDOK, 338, 374, 110, 24
    PUSHBUTTON      "キャンセル", IDCANCEL, 458, 374, 90, 24
END
