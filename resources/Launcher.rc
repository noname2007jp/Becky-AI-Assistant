#pragma code_page(65001)
#include <windows.h>
#include "../src/ui/resource.h"

IDD_AI_LAUNCHER DIALOGEX 0, 0, 300, 462
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "Becky AI Assistant", -1, 16, 12, 268, 18
    LTEXT           "対象メール", -1, 17, 34, 80, 12
    LTEXT           "件名:", -1, 17, 50, 38, 12
    LTEXT           "", IDC_MAIL_SUBJECT, 56, 50, 225, 24, SS_LEFT
    LTEXT           "差出人:", -1, 17, 76, 38, 12
    LTEXT           "", IDC_MAIL_FROM, 56, 76, 225, 24, SS_LEFT

    LTEXT           "本文プレビュー", -1, 17, 106, 264, 12
    EDITTEXT        IDC_MAIL_BODY, 17, 122, 264, 130, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_MAIL_BODY_STATUS, 17, 257, 264, 16

    LTEXT           "Geminiモデル", -1, 17, 280, 264, 12
    COMBOBOX        IDC_GEMINI_MODEL, 17, 296, 264, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "何をしますか？", -1, 17, 321, 264, 12
    PUSHBUTTON      "メールを要約", IDC_AI_SUMMARY, 17, 339, 264, 27
    PUSHBUTTON      "返信文案を作成", IDC_AI_REPLY, 17, 371, 264, 27
    PUSHBUTTON      "AIに相談", IDC_AI_CONSULT, 17, 403, 264, 27

    CONTROL         "", -1, "STATIC", SS_ETCHEDHORZ, 17, 436, 264, 1
    PUSHBUTTON      "設定", IDC_AI_SETTINGS, 17, 443, 75, 18
    DEFPUSHBUTTON   "閉じる", IDOK, 206, 443, 75, 18
END

IDD_AI_SETTINGS DIALOGEX 0, 0, 300, 164
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant - 設定"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "Gemini APIキー", -1, 12, 10, 240, 12
    EDITTEXT        IDC_GEMINI_API_KEY, 12, 27, 276, 18, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    CONTROL         "", IDC_GEMINI_APIKEY_LINK, "SysLink", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 12, 51, 276, 16
    LTEXT           "キーはWindows DPAPIで暗号化して保存します。", -1, 12, 72, 276, 12
    LTEXT           "", IDC_SETTINGS_STATUS, 12, 89, 276, 24
    PUSHBUTTON      "接続テスト", IDC_SETTINGS_TEST, 12, 128, 85, 22
    DEFPUSHBUTTON   "保存", IDC_SETTINGS_SAVE, 158, 128, 60, 22
    PUSHBUTTON      "閉じる", IDCANCEL, 228, 128, 60, 22
END

IDD_AI_RESULT DIALOGEX 0, 0, 440, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Geminiによるメール要約"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "要約結果（本文を選択して Ctrl+C で部分コピーできます）", -1, 12, 10, 416, 14
    EDITTEXT        IDC_AI_RESULT_TEXT, 12, 29, 416, 240, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AI_COPY_STATUS, 12, 276, 285, 16
    PUSHBUTTON      "全文コピー", IDC_AI_COPY_ALL, 300, 273, 65, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_RESULT_CLOSE, 370, 273, 58, 24
END
