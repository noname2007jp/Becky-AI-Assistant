#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "../src/ui/resource.h"

IDD_AI_LAUNCHER DIALOGEX 0, 0, 300, 366
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "件名:", -1, 17, 12, 38, 12
    LTEXT           "", IDC_MAIL_SUBJECT, 56, 12, 225, 18, SS_LEFT
    LTEXT           "差出人:", -1, 17, 32, 38, 12
    LTEXT           "", IDC_MAIL_FROM, 56, 32, 225, 18, SS_LEFT

    LTEXT           "本文プレビュー", -1, 17, 55, 264, 12
    EDITTEXT        IDC_MAIL_BODY, 17, 70, 264, 62, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_MAIL_BODY_STATUS, 17, 135, 194, 14
    PUSHBUTTON      "キャンセル", IDC_AI_CANCEL_GENERATION, 218, 133, 63, 20

    CONTROL         "マスキングして送信（全機能共通）", IDC_MASK_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 17, 153, 250, 18

    LTEXT           "返信に盛り込む内容（任意・箇条書き可）", -1, 17, 177, 264, 12
    EDITTEXT        IDC_REPLY_REQUIREMENTS, 17, 192, 264, 48, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER

    LTEXT           "Geminiモデル", -1, 17, 248, 122, 12
    LTEXT           "返信トーン：標準", IDC_REPLY_TONE_LABEL, 147, 248, 134, 12
    COMBOBOX        IDC_GEMINI_MODEL, 17, 263, 122, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_REPLY_TONE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 147, 263, 134, 25
    LTEXT           "強ビジネス文書", -1, 147, 290, 67, 12
    LTEXT           "簡潔", -1, 255, 290, 26, 12, SS_RIGHT

    PUSHBUTTON      "メール要約", IDC_AI_SUMMARY, 17, 338, 84, 26
    PUSHBUTTON      "返信文案", IDC_AI_REPLY, 107, 338, 84, 26
    PUSHBUTTON      "AIに相談", IDC_AI_CONSULT, 197, 338, 84, 26

END

IDD_AI_SETTINGS DIALOGEX 0, 0, 360, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant - 設定"
FONT 9, "Meiryo UI"
BEGIN
    CONTROL         "", IDC_SETTINGS_TABS, "SysTabControl32", WS_TABSTOP | WS_CHILD | WS_VISIBLE, 10, 10, 340, 230
    LTEXT           "Gemini APIキー", IDC_SETTINGS_LABEL_API, 20, 52, 240, 12
    EDITTEXT        IDC_GEMINI_API_KEY, 20, 69, 250, 18, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    PUSHBUTTON      "表示", IDC_SETTINGS_TOGGLE_KEY, 278, 69, 62, 18
    CONTROL         "", IDC_GEMINI_APIKEY_LINK, "SysLink", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 20, 94, 320, 16
    LTEXT           "キーはWindows DPAPIで暗号化して保存します。", IDC_SETTINGS_LABEL_API_NOTE, 20, 116, 320, 12
    LTEXT           "デフォルトGeminiモデル", IDC_SETTINGS_LABEL_MODEL, 20, 144, 320, 12
    COMBOBOX        IDC_SETTINGS_DEFAULT_MODEL, 20, 161, 320, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_SETTINGS_PRICING_LINK, "SysLink", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 20, 194, 320, 16
    PUSHBUTTON      "APIモデルを更新", IDC_SETTINGS_UPDATE_MODELS, 20, 214, 112, 22
    PUSHBUTTON      "接続テスト", IDC_SETTINGS_TEST, 142, 214, 90, 22
    LTEXT           "マスキング対象（種類ごとに選択）", IDC_SETTINGS_LABEL_MASK, 20, 42, 320, 12
    CONTROL         "メールアドレス", IDC_MASK_EMAIL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 60, 150, 16
    CONTROL         "電話番号", IDC_MASK_PHONE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 80, 150, 16
    CONTROL         "郵便番号", IDC_MASK_POSTAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 100, 150, 16
    CONTROL         "IPアドレス", IDC_MASK_IP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 120, 150, 16
    CONTROL         "会社名", IDC_MASK_COMPANY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 190, 60, 150, 16
    CONTROL         "氏名", IDC_MASK_PERSON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 190, 80, 150, 16
    CONTROL         "住所", IDC_MASK_ADDRESS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 190, 100, 150, 16
    CONTROL         "口座・顧客・社員番号", IDC_MASK_ACCOUNT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 190, 120, 150, 16
    CONTROL         "追加登録した語句", IDC_MASK_CUSTOM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 142, 180, 16
    LTEXT           "追加でマスキングする語句（1行に1件）", IDC_SETTINGS_LABEL_MASK_TERMS, 20, 168, 320, 12
    EDITTEXT        IDC_SETTINGS_MASK_TERMS, 20, 185, 320, 68, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "氏名・会社名などは自動検出できない場合があります。", IDC_SETTINGS_LABEL_MASK_NOTE, 20, 257, 320, 12
    CONTROL         "一時的なエラー時に無料枠ありのFlashモデルへ自動切り替え", IDC_SETTINGS_AUTO_FALLBACK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 48, 320, 18
    CONTROL         "一覧更新時のみ有料・料金未確認モデルも含める", IDC_SETTINGS_INCLUDE_PAID, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 76, 320, 18
    CONTROL         "詳細デバッグログを有効にする（マスキングON時のみ送信内容を記録）", IDC_SETTINGS_DEBUG_LOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 104, 320, 18
    LTEXT           "ログにはマスキング後の送信文章が残ります。未検出情報が含まれる可能性があるため、確認後は削除してください。", IDC_SETTINGS_LABEL_DEBUG_NOTE, 20, 130, 320, 32
    LTEXT           "", IDC_SETTINGS_STATUS, 12, 258, 336, 24
    DEFPUSHBUTTON   "保存", IDC_SETTINGS_SAVE, 210, 300, 62, 22
    PUSHBUTTON      "閉じる", IDCANCEL, 282, 300, 66, 22
END

IDD_AI_RESULT DIALOGEX 0, 0, 568, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Geminiによるメール要約"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "結果（返信文案は編集できます）", -1, 12, 10, 544, 14
    CONTROL         "", IDC_AI_RESULT_TEXT, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | ES_NOHIDESEL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 12, 29, 544, 240
    LTEXT           "", IDC_AI_COPY_STATUS, 12, 276, 255, 16
    PUSHBUTTON      "全文コピー", IDC_AI_COPY_ALL, 273, 273, 65, 24
    PUSHBUTTON      "返信に挿入", IDC_AI_INSERT_REPLY, 343, 273, 72, 24
    PUSHBUTTON      "全員に返信", IDC_AI_INSERT_REPLY_ALL, 420, 273, 82, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_RESULT_CLOSE, 507, 273, 49, 24
END


IDD_AI_CONSULT DIALOGEX 0, 0, 520, 448
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "メールについてAIに相談"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "元メールと会話履歴を踏まえて追加質問できます。", -1, 12, 10, 496, 16
    LTEXT           "質問（複数行・箇条書き可）", -1, 12, 31, 200, 12
    EDITTEXT        IDC_AI_CONSULT_QUESTION, 12, 47, 496, 72, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "質問する", IDC_AI_CONSULT_SEND, 12, 126, 76, 24
    LTEXT           "", IDC_AI_CONSULT_STATUS, 98, 131, 410, 16
    LTEXT           "過去の質問", -1, 12, 156, 120, 12
    COMBOBOX        IDC_AI_CONSULT_PAST_QUESTIONS, 12, 172, 360, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "選択した質問を再入力", IDC_AI_CONSULT_REUSE_QUESTION, 380, 171, 128, 24
    LTEXT           "会話履歴（Becky!終了まで保持）", -1, 12, 202, 220, 12
    COMBOBOX        IDC_AI_CONSULT_SESSIONS, 12, 218, 360, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "新しい相談", IDC_AI_CONSULT_NEW, 380, 217, 128, 22
    CONTROL         "", IDC_AI_CONSULT_RESPONSE, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 12, 244, 496, 78
    LTEXT           "返信に盛り込む内容（任意・箇条書き可）", -1, 12, 328, 300, 12
    EDITTEXT        IDC_AI_CONSULT_REPLY_POINTS, 12, 344, 496, 48, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "回答をコピー", IDC_AI_CONSULT_COPY, 12, 408, 90, 24
    PUSHBUTTON      "この相談を削除", IDC_AI_CONSULT_CLEAR, 110, 408, 76, 24
    PUSHBUTTON      "回答から返信文案", IDC_AI_CONSULT_REPLY, 198, 408, 145, 24
    PUSHBUTTON      "キャンセル", IDC_AI_CONSULT_CANCEL, 350, 408, 88, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_CONSULT_CLOSE, 445, 408, 63, 24
END

IDD_NEWMAIL_COMPOSE DIALOGEX 0, 0, 560, 460
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "AIで新規メール作成"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "メールの目的（必須）", -1, 12, 10, 260, 12
    EDITTEXT        IDC_NEWMAIL_PURPOSE, 12, 26, 536, 42, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "補足条件・含めたい内容（任意）", -1, 12, 74, 300, 12
    EDITTEXT        IDC_NEWMAIL_REQUIREMENTS, 12, 90, 536, 46, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "Geminiモデル", -1, 12, 146, 190, 12
    COMBOBOX        IDC_NEWMAIL_MODEL, 12, 162, 190, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "文体：標準", -1, 214, 146, 82, 12
    CONTROL         "", IDC_NEWMAIL_TONE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 300, 158, 150, 26
    LTEXT           "堅め", -1, 300, 184, 45, 12
    LTEXT           "簡潔", -1, 405, 184, 45, 12, SS_RIGHT
    PUSHBUTTON      "文案を作成", IDC_NEWMAIL_GENERATE, 458, 158, 90, 26
    LTEXT           "", IDC_NEWMAIL_STATUS, 12, 196, 536, 16
    LTEXT           "件名（編集可）", -1, 12, 222, 180, 12
    EDITTEXT        IDC_NEWMAIL_SUBJECT, 12, 238, 536, 24, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "本文（編集可）", -1, 12, 270, 180, 12
    EDITTEXT        IDC_NEWMAIL_BODY, 12, 286, 536, 116, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "キャンセル", IDC_NEWMAIL_CANCEL, 248, 418, 90, 24
    DEFPUSHBUTTON   "作成画面に反映", IDC_NEWMAIL_APPLY, 346, 418, 110, 24
    PUSHBUTTON      "閉じる", IDCANCEL, 466, 418, 82, 24
END

IDD_PII_MASK_PREVIEW DIALOGEX 0, 0, 560, 430
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Gemini送信内容の確認"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "マウスで語句を選択し「選択範囲をマスク」を押すと、同じ語句を送信内容内のすべての箇所でマスクします。", IDC_PII_MASK_PREVIEW_NOTE, 12, 10, 536, 24
    EDITTEXT        IDC_PII_MASK_PREVIEW_TEXT, 12, 40, 536, 320, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_NOHIDESEL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "選択範囲をマスク", IDC_PII_MASK_SELECTION, 12, 374, 112, 24
    LTEXT           "本文中の文字列を選択してから押してください。", -1, 132, 379, 300, 16
    DEFPUSHBUTTON   "この内容で送信", IDOK, 338, 398, 110, 24
    PUSHBUTTON      "キャンセル", IDCANCEL, 458, 398, 90, 24
END


IDD_EMAIL_PROOFREAD DIALOGEX 0, 0, 620, 520
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "メール本文の校正"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "校正対象（現在のメール本文）", -1, 12, 10, 285, 12
    LTEXT           "校正結果（編集してから適用できます）", -1, 316, 10, 292, 12
    EDITTEXT        IDC_PROOFREAD_ORIGINAL, 12, 26, 292, 390, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | WS_BORDER
    EDITTEXT        IDC_PROOFREAD_RESULT, 316, 26, 292, 390, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "Geminiモデル", -1, 12, 428, 78, 12
    COMBOBOX        IDC_PROOFREAD_MODEL, 92, 424, 190, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "マスキングする", IDC_PROOFREAD_MASK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 300, 426, 120, 18
    LTEXT           "文章レベル", -1, 12, 452, 62, 12
    CONTROL         "", IDC_PROOFREAD_LEVEL, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 78, 448, 300, 24
    LTEXT           "", IDC_PROOFREAD_LEVEL_LABEL, 386, 452, 222, 16
    LTEXT           "", IDC_PROOFREAD_STATUS, 12, 478, 596, 16
    PUSHBUTTON      "校正する", IDC_PROOFREAD_RUN, 316, 496, 82, 22
    PUSHBUTTON      "キャンセル", IDC_PROOFREAD_CANCEL_REQUEST, 404, 496, 82, 22
    DEFPUSHBUTTON   "校正結果を適用", IDC_PROOFREAD_APPLY, 492, 496, 116, 22
    PUSHBUTTON      "閉じる", IDC_PROOFREAD_CLOSE, 12, 496, 72, 22
END
