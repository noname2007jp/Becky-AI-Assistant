#pragma code_page(65001)
#include <windows.h>
#include "../src/ui/resource.h"

IDD_AI_LAUNCHER DIALOGEX 0, 0, 300, 430
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "Becky AI Assistant", -1, 16, 12, 268, 18
    LTEXT           "対象メール", -1, 17, 34, 80, 12
    LTEXT           "件名:", -1, 17, 50, 38, 12
    LTEXT           "", IDC_MAIL_SUBJECT, 56, 50, 225, 24, SS_LEFT
    LTEXT           "差出人:", -1, 17, 76, 38, 12
    LTEXT           "", IDC_MAIL_FROM, 56, 76, 225, 24, SS_LEFT

    LTEXT           "本文プレビュー", -1, 17, 106, 264, 12
    EDITTEXT        IDC_MAIL_BODY, 17, 122, 264, 130, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_MAIL_BODY_STATUS, 17, 257, 264, 16

    LTEXT           "何をしますか？", -1, 17, 280, 264, 12
    PUSHBUTTON      "メールを要約", IDC_AI_SUMMARY, 17, 298, 264, 27
    PUSHBUTTON      "返信文案を作成", IDC_AI_REPLY, 17, 330, 264, 27
    PUSHBUTTON      "AIに相談", IDC_AI_CONSULT, 17, 362, 264, 27

    CONTROL         "", -1, "STATIC", SS_ETCHEDHORZ, 17, 395, 264, 1
    PUSHBUTTON      "設定", IDC_AI_SETTINGS, 17, 403, 75, 18
    DEFPUSHBUTTON   "閉じる", IDOK, 206, 403, 75, 18
END
