#pragma code_page(65001)
#include <windows.h>
#include "../src/ui/resource.h"

IDD_AI_LAUNCHER DIALOGEX 0, 0, 300, 262
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "件名:", -1, 17, 12, 38, 12
    LTEXT           "", IDC_MAIL_SUBJECT, 56, 12, 225, 18, SS_LEFT
    LTEXT           "差出人:", -1, 17, 32, 38, 12
    LTEXT           "", IDC_MAIL_FROM, 56, 32, 225, 18, SS_LEFT

    LTEXT           "本文プレビュー", -1, 17, 55, 264, 12
    EDITTEXT        IDC_MAIL_BODY, 17, 70, 264, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_MAIL_BODY_STATUS, 17, 148, 264, 14

    LTEXT           "Geminiモデル", -1, 17, 169, 122, 12
    LTEXT           "返信トーン：標準", IDC_REPLY_TONE_LABEL, 147, 169, 134, 12
    COMBOBOX        IDC_GEMINI_MODEL, 17, 184, 122, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_REPLY_TONE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 147, 182, 134, 25
    LTEXT           "強ビジネス文書", -1, 147, 208, 67, 12
    LTEXT           "簡潔", -1, 255, 208, 26, 12, SS_RIGHT

    PUSHBUTTON      "メール要約", IDC_AI_SUMMARY, 17, 227, 84, 26
    PUSHBUTTON      "返信文案", IDC_AI_REPLY, 107, 227, 84, 26
    PUSHBUTTON      "AIに相談", IDC_AI_CONSULT, 197, 227, 84, 26

END

IDD_AI_SETTINGS DIALOGEX 0, 0, 300, 164
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant - 設定"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "Gemini APIキー", -1, 12, 10, 240, 12
    EDITTEXT        IDC_GEMINI_API_KEY, 12, 27, 198, 18, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    PUSHBUTTON      "表示", IDC_SETTINGS_TOGGLE_KEY, 216, 27, 72, 18
    CONTROL         "", IDC_GEMINI_APIKEY_LINK, "SysLink", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 12, 51, 276, 16
    LTEXT           "キーはWindows DPAPIで暗号化して保存します。", -1, 12, 72, 276, 12
    LTEXT           "", IDC_SETTINGS_STATUS, 12, 89, 276, 24
    PUSHBUTTON      "接続テスト", IDC_SETTINGS_TEST, 12, 128, 85, 22
    DEFPUSHBUTTON   "保存", IDC_SETTINGS_SAVE, 158, 128, 60, 22
    PUSHBUTTON      "閉じる", IDCANCEL, 228, 128, 60, 22
END

IDD_AI_RESULT DIALOGEX 0, 0, 568, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Geminiによるメール要約"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "結果（返信文案は編集できます）", -1, 12, 10, 544, 14
    CONTROL         "", IDC_AI_RESULT_TEXT, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | ES_NOHIDESEL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 12, 29, 544, 240
    LTEXT           "", IDC_AI_COPY_STATUS, 12, 276, 255, 16
    PUSHBUTTON      "全文コピー", IDC_AI_COPY_ALL, 273, 273, 65, 24
    PUSHBUTTON      "返信に挿入", IDC_AI_INSERT_REPLY, 343, 273, 72, 24
    PUSHBUTTON      "全員に返信", IDC_AI_INSERT_REPLY_ALL, 420, 273, 82, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_RESULT_CLOSE, 507, 273, 49, 24
END


IDD_AI_CONSULT DIALOGEX 0, 0, 520, 360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "メールについてAIに相談"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "メール内容について質問できます。質問ごとに元メールを参照して回答します。", -1, 12, 10, 496, 16
    LTEXT           "質問", -1, 12, 31, 50, 12
    EDITTEXT        IDC_AI_CONSULT_QUESTION, 12, 47, 496, 54, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "質問する", IDC_AI_CONSULT_SEND, 12, 108, 76, 24
    LTEXT           "", IDC_AI_CONSULT_STATUS, 98, 113, 410, 16
    LTEXT           "回答", -1, 12, 142, 50, 12
    CONTROL         "", IDC_AI_CONSULT_RESPONSE, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 12, 158, 496, 152
    PUSHBUTTON      "回答をコピー", IDC_AI_CONSULT_COPY, 12, 322, 90, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_CONSULT_CLOSE, 445, 322, 63, 24
END
