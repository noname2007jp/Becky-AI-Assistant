#pragma code_page(65001)
#include <windows.h>
#include "../src/ui/resource.h"

IDD_AI_LAUNCHER DIALOGEX 0, 0, 300, 344
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "Becky AI Assistant", -1, 16, 10, 268, 16
    LTEXT           "対象メール", -1, 17, 29, 80, 12
    LTEXT           "件名:", -1, 17, 45, 38, 12
    LTEXT           "", IDC_MAIL_SUBJECT, 56, 45, 225, 18, SS_LEFT
    LTEXT           "差出人:", -1, 17, 65, 38, 12
    LTEXT           "", IDC_MAIL_FROM, 56, 65, 225, 18, SS_LEFT

    LTEXT           "本文プレビュー", -1, 17, 88, 264, 12
    EDITTEXT        IDC_MAIL_BODY, 17, 103, 264, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_MAIL_BODY_STATUS, 17, 181, 264, 14

    LTEXT           "Geminiモデル", -1, 17, 202, 122, 12
    LTEXT           "返信トーン：標準", IDC_REPLY_TONE_LABEL, 147, 202, 134, 12
    COMBOBOX        IDC_GEMINI_MODEL, 17, 217, 122, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_REPLY_TONE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 147, 215, 134, 25
    LTEXT           "強ビジネス文書", -1, 147, 241, 67, 12
    LTEXT           "簡潔", -1, 255, 241, 26, 12, SS_RIGHT

    PUSHBUTTON      "メール要約", IDC_AI_SUMMARY, 17, 260, 84, 26
    PUSHBUTTON      "返信文案", IDC_AI_REPLY, 107, 260, 84, 26
    PUSHBUTTON      "AIに相談", IDC_AI_CONSULT, 197, 260, 84, 26

    CONTROL         "", -1, "STATIC", SS_ETCHEDHORZ, 17, 293, 264, 1
    PUSHBUTTON      "設定", IDC_AI_SETTINGS, 17, 303, 75, 22
    DEFPUSHBUTTON   "閉じる", IDOK, 206, 303, 75, 22
END

IDD_AI_SETTINGS DIALOGEX 0, 0, 300, 164
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Becky AI Assistant - 設定"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "Gemini APIキー", -1, 12, 10, 240, 12
    EDITTEXT        IDC_GEMINI_API_KEY, 12, 27, 276, 18, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    CONTROL         "", IDC_GEMINI_APIKEY_LINK, "SysLink", WS_TABSTOP | WS_VISIBLE | WS_CHILD, 12, 51, 276, 16
    LTEXT           "キーはWindows DPAPIで暗号化して保存します。", -1, 12, 72, 276, 12
    LTEXT           "", IDC_SETTINGS_STATUS, 12, 89, 276, 24
    PUSHBUTTON      "接続テスト", IDC_SETTINGS_TEST, 12, 128, 85, 22
    DEFPUSHBUTTON   "保存", IDC_SETTINGS_SAVE, 158, 128, 60, 22
    PUSHBUTTON      "閉じる", IDCANCEL, 228, 128, 60, 22
END

IDD_AI_RESULT DIALOGEX 0, 0, 520, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Geminiによるメール要約"
FONT 9, "Meiryo UI"
BEGIN
    LTEXT           "結果（返信文案は編集できます）", -1, 12, 10, 496, 14
    CONTROL         "", IDC_AI_RESULT_TEXT, "RICHEDIT50W", ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | ES_NOHIDESEL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 12, 29, 496, 240
    LTEXT           "", IDC_AI_COPY_STATUS, 12, 276, 280, 16
    PUSHBUTTON      "全文コピー", IDC_AI_COPY_ALL, 298, 273, 65, 24
    PUSHBUTTON      "返信に挿入", IDC_AI_INSERT_REPLY, 368, 273, 72, 24
    DEFPUSHBUTTON   "閉じる", IDC_AI_RESULT_CLOSE, 445, 273, 63, 24
END
